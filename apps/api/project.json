{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api",
  "root": "apps/api",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run dev:vercel", "cwd": "apps/api" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run build", "cwd": "apps/api" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run typecheck", "cwd": "apps/api" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run lint", "cwd": "apps/api" }
    }
  }
}

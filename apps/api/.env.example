# Postgres (Neon) connection string. Set by the Neon integration on the Vercel project; get it locally with
# `vercel env pull .env.local`, then run `pnpm db:migrate`. Never commit it.
DATABASE_URL=

# Direct, non-pooled connection of the same Neon branch; used only by Prisma Migrate (`pnpm db:migrate`).
# Set by the Neon integration. Never commit it.
DATABASE_URL_UNPOOLED=

# Secret used to sign/verify JWTs issued by POST /auth/token.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=

# Optional: port used by `pnpm dev:local` (plain Express listener, not `vercel dev`).
# Must not be 4000 — that's server/ (006) and apps/web's coins client default.
PORT=4001

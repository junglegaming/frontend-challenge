# Production build settings for apps/web (read by `vite build`; Vercel project env vars override these).
# Only non-secret, public values belong here: every VITE_* is embedded in the browser bundle.
# Matrix and rationale: specs/008-web-production-env/data-model.md

# The product is a demo (constitution, principle V): MSW keeps serving /api/*.
VITE_ENABLE_MOCKS=true
# /backend/* must reach the real apps/api, so its mock handlers stay off in production.
VITE_ENABLE_BACKEND_MOCKS=false

# Same-origin prefixes. vercel.json rewrites /backend/:path* -> <api>/api/:path*.
VITE_API_BASE_URL=/api
VITE_BACKEND_BASE_URL=/backend
VITE_REQUEST_TIMEOUT_MS=8000

# MSW route identifier for the mocked realtime channel; never opened as a real socket.
VITE_SOCKET_URL=ws://localhost/realtime

# Coins (specs/011-web-coins-real-api) use the real apps/api through the same-origin /backend path, so no coins
# variable exists: VITE_ENABLE_BACKEND_MOCKS=false above is what makes /backend reach the real API.

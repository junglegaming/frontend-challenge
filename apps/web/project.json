{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web",
  "root": "apps/web",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run dev", "cwd": "apps/web" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run build", "cwd": "apps/web" },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run typecheck", "cwd": "apps/web" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run lint", "cwd": "apps/web" }
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run test:e2e", "cwd": "apps/web" }
    }
  }
}

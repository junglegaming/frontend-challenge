# Base path of the REST API (served by MSW when mocks are enabled)
VITE_API_BASE_URL=/api
# Same-origin path of the real Vercel/Blob backend (apps/api). Proxied to the API's /api/* by Vite
# (dev/preview, target = BACKEND_PROXY_TARGET below) and by vercel.json (production).
VITE_BACKEND_BASE_URL=/backend
# Where Vite's dev/preview proxy sends /backend/*: `vercel dev` in apps/api (port 3000), or the deployed API URL.
BACKEND_PROXY_TARGET=http://localhost:3000
# Socket.IO endpoint (intercepted by @mswjs/socket.io-binding when mocks are enabled)
VITE_SOCKET_URL=ws://localhost/realtime
# Enables the MSW network layer for /api/* (dev, demo build, Playwright).
# Production KEEPS this `true`: the whole product is a mock-driven demo (constitution, Principle V).
VITE_ENABLE_MOCKS=true
# Mocks the real backend (/backend/*, apps/api) too. Default when unset: `true` in dev, `false` in a
# production build. Production/preview MUST NOT mock it, or the real API is never reached.
VITE_ENABLE_BACKEND_MOCKS=true
VITE_REQUEST_TIMEOUT_MS=8000
